  {
   "type": "schema-blocks",
   "id": "697b72f711a8e98484c613bd",
   "attributes": {
    "block_type": "select-input-option",
    "display_text": "No causal relationship inferred: This study is not intended to inform a causal relationship. ",
    "registration_response_key": null,
    "schema_block_group_key": "group-05"
   }
  },
  {
   "type": "schema-blocks",
   "id": "697b72f711a8e98484c613be",
   "attributes": {
    "block_type": "select-input-option",
    "display_text": "Indirect inference on causal relationship(s): This study is intended to examine a potential causal relationship, but is not designed to isolate the specific causal effect. This work may inform causal inference indirectly or advance insight toward future estimation of a causal relationship. ",
    "registration_response_key": null,
    "schema_block_group_key": "group-05"
   }
  },
  {
   "type": "schema-blocks",
   "id": "697b72f711a8e98484c613bf",
   "attributes": {
    "block_type": "select-input-option",
    "display_text": "Direct inference on causal relationship(s): This study is intended to infer or estimate a causal relationship between two or more variables. It is designed specifically for the purposes of causal inference or identification.",
    "registration_response_key": null,
    "schema_block_group_key": "group-05"
   }
  },
