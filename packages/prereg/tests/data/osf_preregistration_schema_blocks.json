   "attributes": {
    "block_type": "question-label",
    "display_text": "Study type",
    "registration_response_key": null,
    "schema_block_group_key": "group-04"
   }
  },
  {
   "type": "schema-blocks",
   "id": "697b72f711a8e98484c613b1",
   "attributes": {
    "block_type": "multi-select-input",
    "display_text": "",
