    "schema_block_group_key": "group-04"
   }
  },
  {
   "type": "schema-blocks",
   "id": "697b72f711a8e98484c613b2",
   "attributes": {
    "block_type": "select-input-option",
    "display_text": "Randomized Experiment: Must include random assignment of subjects to treatments or conditions. This usually includes lab experiments, field experiments, intervention experiments, randomized controlled trials, and A/B testing.",
    "registration_response_key": null,
    "schema_block_group_key": "group-04"
   }
  },
  {
   "type": "schema-blocks",
   "id": "697b72f711a8e98484c613b3",
   "attributes": {
    "block_type": "select-input-option",
    "display_text": "Non-randomized study: Does not include random assignment of subjects to treatments or conditions. This usually includes correlational studies, observational studies, surveys, natural experiments, real-world evidence studies, regression discontinuity designs, and descriptive studies.",
    "registration_response_key": null,
    "schema_block_group_key": "group-04"
   }
  },
  {
   "type": "schema-blocks",
   "id": "697b72f711a8e98484c613b4",
   "attributes": {
    "block_type": "select-input-option",
    "display_text": "Systematic review: A meta-analysis or other form of systematic review of existing research including scoping reviews.",
    "registration_response_key": null,
    "schema_block_group_key": "group-04"
   }
  },
  {
   "type": "schema-blocks",
   "id": "697b72f711a8e98484c613b5",
   "attributes": {
    "block_type": "select-input-option",
    "display_text": "Adjustment or control-based design: The association between variables is adjusted or controlled for a set of other factors that would otherwise influence the estimation of that relationship. Note that typically this is performed in order to eliminate influences to help isolate some causal effect. If there is a reason other than isolating a causal effect for controlling for variables, please describe it.",
    "registration_response_key": null,
    "schema_block_group_key": "group-04"
   }
  },
  {
   "type": "schema-blocks",
   "id": "697b72f711a8e98484c613b6",
   "attributes": {
    "block_type": "select-input-option",
    "display_text": "Quasi-experimental design: The strategy to identify or estimate a causal relationship takes advantage of some particular feature(s) or circumstance(s) that helps avoid much of the need for adjustment or control variables. This may include instrumental variables, \"natural\" experiments, interrupted time series designs, difference-in-difference designs, synthetic controls, or related approaches.",
    "registration_response_key": null,
    "schema_block_group_key": "group-04"
   }
  },
  {
   "type": "schema-blocks",
   "id": "697b72f711a8e98484c613b7",
   "attributes": {
    "block_type": "select-input-option",
    "display_text": "Descriptive study: Describing some features of a dataset or sample, but typically not for the purposes of informing a causal effect.",
    "registration_response_key": null,
    "schema_block_group_key": "group-04"
   }
  },
  {
   "type": "schema-blocks",
   "id": "697b72f711a8e98484c613b8",
   "attributes": {
    "block_type": "select-input-option",
    "display_text": "Simulation study: Using existing or synthetic data to assess performance of a model, mimic operation of an existing or proposed system, or predict possible outcomes in a controlled context. This may include demonstration of methods, many varieties of modeling, prediction of policy impacts, simulating behavior or outcomes in a population, and other designs.",
    "registration_response_key": null,
    "schema_block_group_key": "group-04"
   }
  },
  {
   "type": "schema-blocks",
   "id": "697b72f711a8e98484c613b9",
   "attributes": {
    "block_type": "select-input-option",
    "display_text": "Other",
    "registration_response_key": null,
    "schema_block_group_key": "group-04"
   }
  },
  {
   "type": "schema-blocks",
   "id": "697b72f711a8e98484c613bb",
   "attributes": {
    "block_type": "question-label",
    "display_text": "Intention for causal interpretation",
