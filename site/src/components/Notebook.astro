---
// A notebook, without a notebook server. Pyodide loads CPython into the page and micropip
// installs the published wheels from PyPI, so every cell below runs the same code a reader
// would get from `pip install`. Nothing is uploaded and nothing is signed into.
//
// Two things WASM cannot do, and the cells avoid rather than fake: there is no shell, so a
// CLI is invoked through its `main()` rather than with `!`; and there is no process model, so
// anything shelling out to git (`prereg freeze`) is out of scope here.
---

<div class="nb">
  <div class="nb-bar">
    <button id="nb-run" type="button" class="nb-primary">Run all cells</button>
    <button id="nb-reset" type="button">Reset</button>
    <span id="nb-status">Python is not loaded yet — running a cell will fetch it (~10 MB, once).</span>
  </div>
  <div id="nb-cells"></div>
</div>

<script>
  const CELLS: [string, string][] = [
    ["Install the published packages", `import micropip
await micropip.install(["results-cli==0.2.0", "reproducible-science==0.2.0"])
import results, repro
print("results-cli", results.__version__ if hasattr(results, "__version__") else "0.2.0")
print("reproducible-science 0.2.0")`],

    ["A result to make claims about", `import json, os, pathlib
os.makedirs("/tmp/demo", exist_ok=True); os.chdir("/tmp/demo")
pathlib.Path("results.json").write_text(json.dumps({"primary": {"effect": 0.404, "n": 200}}, indent=2))
print(pathlib.Path("results.json").read_text())`],

    ["Seal the input, record the run, bind the claim", `cli("results.cli", "init")
cli("results.cli", "seal", "results.json", "--role", "input")
cli("results.cli", "run", "results.json", "--run-id", "exp_001")
cli("results.cli", "claim", "The primary effect was 0.404", "--run-id", "exp_001")`],

    ["The ledger is a hash chain with a length anchor", `cli("results.cli", "verify")`],

    ["Declare what the manuscript says", `pathlib.Path("repro.yaml").write_text('''schema_version: repro/1
project: demo
artifacts:
  - id: results
    path: results.json
claims:
  - id: primary
    text: The primary effect was 0.404
    evidence:
      - kind: metric
        artifact: results
        name: effect
        pointer: /primary/effect
        reported: "0.404"
''')
cli("repro.cli", "verify", "repro.yaml")`],

    ["Break it: the manuscript prints a different number", `text = pathlib.Path("repro.yaml").read_text()
pathlib.Path("repro.yaml").write_text(text.replace('"0.404"', '"0.410"'))
cli("repro.cli", "verify", "repro.yaml")
pathlib.Path("repro.yaml").write_text(text)`],

    ["Break it: the address resolves to nothing", `text = pathlib.Path("repro.yaml").read_text()
pathlib.Path("repro.yaml").write_text(text.replace("/primary/effect", "/primary/effekt"))
cli("repro.cli", "verify", "repro.yaml")
pathlib.Path("repro.yaml").write_text(text)`],

    ["Break it: delete a ledger entry, then try to launder it", `lines = pathlib.Path(".results/ledger.jsonl").read_text().splitlines()
pathlib.Path(".results/ledger.jsonl").write_text("\\n".join(lines[:-1]) + "\\n")
cli("results.cli", "verify")
print("--- trying to re-anchor over it ---")
cli("results.cli", "reanchor")`],
  ];

  let pyodide: any = null;
  const status = document.getElementById("nb-status")!;
  const host = document.getElementById("nb-cells")!;

  const BOOT = `
import sys, io, contextlib

def cli(module, *args):
    """Invoke a console script the way a shell would. WASM has no shell, so the entry
    point is called directly with the argv it would have received."""
    old = sys.argv
    sys.argv = [module.split(".")[0], *args]
    try:
        __import__(module, fromlist=["main"]).main()
    except SystemExit:
        pass
    finally:
        sys.argv = old
`;

  function render() {
    host.innerHTML = "";
    CELLS.forEach(([title, src], i) => {
      const cell = document.createElement("section");
      cell.className = "nb-cell";
      cell.innerHTML = `
        <div class="nb-head">
          <span class="nb-n">[${i + 1}]</span>
          <span class="nb-title">${title}</span>
          <button class="nb-play" data-i="${i}" type="button">Run</button>
        </div>
        <pre class="nb-src"><code>${src.replace(/[&<>]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;" })[c]!)}</code></pre>
        <pre class="nb-out" id="out-${i}" hidden></pre>`;
      host.append(cell);
    });
    host.querySelectorAll<HTMLButtonElement>(".nb-play").forEach((b) =>
      b.addEventListener("click", () => void runCell(Number(b.dataset.i))),
    );
  }

  async function boot() {
    if (pyodide) return pyodide;
    status.textContent = "Loading Python…";
    // @ts-expect-error - loaded from the CDN below
    pyodide = await loadPyodide({ indexURL: "https://cdn.jsdelivr.net/pyodide/v0.28.0/full/" });
    status.textContent = "Loading sqlite3 and micropip…";
    // repro imports sqlite3 at module level for its sqlite locator, so it must be present
    // before `import repro` even when no sqlite artifact is involved.
    await pyodide.loadPackage(["micropip", "sqlite3"]);
    await pyodide.runPythonAsync(BOOT);
    status.textContent = "Python ready.";
    return pyodide;
  }

  async function runCell(i: number) {
    const out = document.getElementById(`out-${i}`)!;
    out.hidden = false;
    out.textContent = "running…";
    try {
      const py = await boot();
      const buf: string[] = [];
      py.setStdout({ batched: (s: string) => buf.push(s) });
      py.setStderr({ batched: (s: string) => buf.push(s) });
      await py.runPythonAsync(CELLS[i][1]);
      out.textContent = buf.join("\n").trimEnd() || "(no output)";
      out.dataset.state = "ok";
    } catch (e) {
      out.textContent = String(e).split("\n").slice(-12).join("\n");
      out.dataset.state = "err";
    }
  }

  document.getElementById("nb-run")!.addEventListener("click", async () => {
    for (let i = 0; i < CELLS.length; i++) await runCell(i);
  });
  document.getElementById("nb-reset")!.addEventListener("click", () => {
    pyodide = null;
    status.textContent = "Reset. The next run reloads Python.";
    render();
  });

  const s = document.createElement("script");
  s.src = "https://cdn.jsdelivr.net/pyodide/v0.28.0/full/pyodide.js";
  document.head.append(s);
  render();
</script>

<style is:global>
  .nb { margin: 1.5rem 0; }
  .nb-bar {
    display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;
    padding-bottom: 1rem; border-bottom: 1px solid var(--sl-color-gray-5); margin-bottom: 1.25rem;
  }
  .nb-bar button {
    font-size: 0.8rem; padding: 0.4rem 0.8rem; border-radius: 0.4375rem; cursor: pointer;
    border: 1px solid var(--sl-color-gray-4); background: var(--sl-color-bg);
    color: var(--sl-color-white); font-family: var(--sl-font);
  }
  .nb-bar button:hover { border-color: var(--sl-color-accent); color: var(--sl-color-accent-high); }
  .nb-primary { background: var(--sl-color-accent) !important; border-color: var(--sl-color-accent) !important; color: #fff !important; }
  #nb-status { font-size: 0.82rem; color: var(--sl-color-gray-2); }

  .nb-cell { margin-bottom: 1.25rem; }
  .nb-head { display: flex; align-items: center; gap: 0.65rem; margin-bottom: 0.4rem; }
  .nb-n { font-family: var(--sl-font-system-mono); font-size: 0.78rem; color: var(--sl-color-gray-3); }
  .nb-title { font-size: 0.9rem; font-weight: 600; flex: 1; }
  .nb-play {
    font-size: 0.75rem; padding: 0.2rem 0.6rem; border-radius: 0.3125rem; cursor: pointer;
    border: 1px solid var(--sl-color-gray-4); background: transparent;
    color: var(--sl-color-white); font-family: var(--sl-font);
  }
  .nb-play:hover { border-color: var(--sl-color-accent); color: var(--sl-color-accent-high); }
  .nb-src {
    margin: 0; padding: 0.7rem 0.85rem; border-radius: 0.4375rem;
    background: var(--sl-color-gray-6); border: 1px solid var(--sl-color-gray-5);
    font-size: 0.8rem; line-height: 1.6; overflow-x: auto;
  }
  .nb-out {
    margin: 0.4rem 0 0; padding: 0.7rem 0.85rem; border-radius: 0.4375rem;
    background: var(--sl-color-black); border-left: 3px solid var(--sl-color-gray-4);
    font-size: 0.78rem; line-height: 1.65; white-space: pre-wrap; overflow-x: auto;
    color: var(--sl-color-white);
  }
  .nb-out[data-state="err"] { border-left-color: #b91c1c; }
  .nb-out[data-state="ok"] { border-left-color: #15803d; }
</style>
